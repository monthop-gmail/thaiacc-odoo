<?xml version="1.0" encoding="utf-8"?>
<!-- Odoo 20 official-first demo: Thai partners, the withholding tax base
     account, and withholding taxes as official account.tax records. -->
<odoo>
    <data noupdate="1">

        <!-- Thai Vendor Partners -->
        <record id="demo_vendor_somchai" model="res.partner">
            <field name="name">บริษัท สมชาย เทรดดิ้ง จำกัด</field>
            <field name="vat">0105560123456</field>
            <field name="street">123 ถ.สุขุมวิท</field>
            <field name="city">กรุงเทพมหานคร</field>
            <field name="zip">10110</field>
            <field name="phone">02-123-4567</field>
            <field name="supplier_rank">1</field>
        </record>

        <record id="demo_vendor_rungrueang" model="res.partner">
            <field name="name">หจก. รุ่งเรือง คอนซัลแตนท์</field>
            <field name="vat">0103560789012</field>
            <field name="supplier_rank">1</field>
        </record>

        <record id="demo_vendor_wichai" model="res.partner">
            <field name="name">นายวิชัย ใจดี</field>
            <field name="vat">1234567890123</field>
            <field name="supplier_rank">1</field>
        </record>

        <record id="demo_customer_thai" model="res.partner">
            <field name="name">บริษัท ลูกค้าไทย จำกัด (มหาชน)</field>
            <field name="vat">0107550345678</field>
            <field name="customer_rank">1</field>
        </record>

        <!-- Withholding tax base account + company setting (official
             l10n_account_withholding_tax engine requirement) -->
        <record id="demo_wht_account" model="account.account">
            <field name="code">213999</field>
            <field name="name">ภาษีหัก ณ ที่จ่ายค้างจ่าย</field>
            <field name="account_type">liability_current</field>
            <field name="reconcile" eval="True"/>
        </record>

        <record id="base.main_company" model="res.company">
            <field name="withholding_tax_base_account_id" ref="demo_wht_account"/>
        </record>

        <!-- Withholding taxes as official account.tax records
             (account.tax.is_withholding_tax engine) -->
        <record id="demo_wht_1_transport" model="account.tax">
            <field name="name">WHT 1% ค่าขนส่ง</field>
            <field name="amount_type">percent</field>
            <field name="amount">-1.0</field>
            <field name="type_tax_use">purchase</field>
            <field name="is_withholding_tax" eval="True"/>
            <field name="l10n_th_income_tax_type">transportation</field>
        </record>

        <record id="demo_wht_2_advertising" model="account.tax">
            <field name="name">WHT 2% ค่าโฆษณา</field>
            <field name="amount_type">percent</field>
            <field name="amount">-2.0</field>
            <field name="type_tax_use">purchase</field>
            <field name="is_withholding_tax" eval="True"/>
            <field name="l10n_th_income_tax_type">advertising</field>
        </record>

        <record id="demo_wht_3_service" model="account.tax">
            <field name="name">WHT 3% ค่าบริการ/จ้างทำของ</field>
            <field name="amount_type">percent</field>
            <field name="amount">-3.0</field>
            <field name="type_tax_use">purchase</field>
            <field name="is_withholding_tax" eval="True"/>
            <field name="l10n_th_income_tax_type">service</field>
        </record>

        <record id="demo_wht_3_service_person" model="account.tax">
            <field name="name">WHT 3% ค่าบริการ (บุคคลธรรมดา)</field>
            <field name="amount_type">percent</field>
            <field name="amount">-3.0</field>
            <field name="type_tax_use">purchase</field>
            <field name="is_withholding_tax" eval="True"/>
            <field name="l10n_th_income_tax_type">service</field>
        </record>

        <record id="demo_wht_5_rent" model="account.tax">
            <field name="name">WHT 5% ค่าเช่า</field>
            <field name="amount_type">percent</field>
            <field name="amount">-5.0</field>
            <field name="type_tax_use">purchase</field>
            <field name="is_withholding_tax" eval="True"/>
            <field name="l10n_th_income_tax_type">rentals</field>
        </record>

        <record id="demo_wht_pit_salary" model="account.tax">
            <field name="name">WHT PIT เงินเดือน (ดูตารางขั้นบันได)</field>
            <field name="amount_type">percent</field>
            <field name="amount">-5.0</field>
            <field name="type_tax_use">purchase</field>
            <field name="is_withholding_tax" eval="True"/>
            <field name="l10n_th_income_tax_type">na</field>
        </record>

    </data>
</odoo>
