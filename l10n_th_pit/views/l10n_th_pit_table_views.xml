<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_th_pit_table_action" model="ir.actions.act_window">
        <field name="name">PIT Rate Tables</field>
        <field name="res_model">l10n_th.pit.table</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="l10n_th_pit_table_view_list" model="ir.ui.view">
        <field name="name">l10n_th.pit.table.list</field>
        <field name="model">l10n_th.pit.table</field>
        <field name="arch" type="xml">
            <list>
                <field name="calendar_year" />
                <field name="rate_ids" widget="many2many_tags" />
            </list>
        </field>
    </record>

    <record id="l10n_th_pit_table_view_form" model="ir.ui.view">
        <field name="name">l10n_th.pit.table.form</field>
        <field name="model">l10n_th.pit.table</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="calendar_year" />
                    </group>
                    <field name="rate_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="income_from" />
                            <field name="income_to" />
                            <field name="tax_rate" />
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem
        id="menu_l10n_th_pit_table"
        name="PIT Rate Tables"
        parent="account.menu_finance_configuration"
        action="l10n_th_pit_table_action"
        sequence="45"
    />
</odoo>
